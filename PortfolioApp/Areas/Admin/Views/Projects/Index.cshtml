@model List<Project>
@{ ViewData["Title"] = "Manage Projects"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">All Projects</h5>
    <a asp-action="Create" class="btn btn-gradient"><i class="fa-solid fa-plus"></i> Add Project</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Image</th><th>Title</th><th>Status</th><th>Featured</th><th>Order</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/project-placeholder.png" : p.ImagePath)" class="admin-thumb" /></td>
                        <td>@p.Title</td>
                        <td>@p.Status</td>
                        <td>@(p.IsFeatured ? "Yes" : "No")</td>
                        <td>@p.DisplayOrder</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn-admin-icon" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline js-confirm-delete">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-admin-icon danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
