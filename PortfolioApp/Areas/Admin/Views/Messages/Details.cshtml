@model Message
@{ ViewData["Title"] = "Message Details"; }
<div class="admin-card" style="max-width:700px;">
    <p><strong>From:</strong> @Model.Name (@Model.Email)</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Subject:</strong> @Model.Subject</p>
    <p><strong>Sent On:</strong> @Model.SentOn.ToString("dd MMM yyyy, hh:mm tt")</p>
    <hr class="admin-nav-divider" />
    <p style="white-space:pre-wrap;">@Model.Body</p>
    <div class="mt-4 d-flex gap-2">
        <a href="mailto:@Model.Email" class="btn btn-gradient"><i class="fa-solid fa-reply"></i> Reply via Email</a>
        <a asp-action="Index" class="btn btn-outline-glass">Back to Messages</a>
    </div>
</div>
