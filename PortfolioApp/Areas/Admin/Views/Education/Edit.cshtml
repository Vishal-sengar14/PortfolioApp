@model Education
@{ ViewData["Title"] = "Edit Education"; }
<div class="admin-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Degree" class="form-label"></label><input asp-for="Degree" class="form-control glass-input" /></div>
            <div class="col-md-6"><label asp-for="Institution" class="form-label"></label><input asp-for="Institution" class="form-control glass-input" /></div>
            <div class="col-md-4"><label asp-for="CGPA" class="form-label"></label><input asp-for="CGPA" class="form-control glass-input" /></div>
            <div class="col-md-4"><label asp-for="StartYear" class="form-label"></label><input asp-for="StartYear" type="number" class="form-control glass-input" /></div>
            <div class="col-md-4"><label asp-for="EndYear" class="form-label"></label><input asp-for="EndYear" type="number" class="form-control glass-input" /></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control glass-input"></textarea></div>
            <div class="col-md-4"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" type="number" class="form-control glass-input" /></div>
            <div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-gradient">Update</button>
            <a asp-action="Index" class="btn btn-outline-glass">Cancel</a>
        </div>
    </form>
</div>
