@{
    ViewData["Title"] = "Page Not Found";
}
<section class="section-padding error-page text-center">
    <div class="container">
        <h1 class="error-code">404</h1>
        <h3 class="mb-3">Page Not Found</h3>
        <p class="text-muted-light">The page you are looking for doesn't exist or has been moved.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-gradient mt-3">Back to Home</a>
    </div>
</section>
