@model Project
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header">
    <div class="container text-center" data-aos="fade-up">
        <span class="section-tag">Project Detail</span>
        <h1>@Model.Title</h1>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7" data-aos="fade-right">
                <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/projects/ProjectImg.png" : Model.ImagePath)" class="img-fluid rounded-4 mb-4" alt="@Model.Title" />

                @if (Model.Screenshots.Any())
                {
                    <div class="row g-3">
                        @foreach (var shot in Model.Screenshots)
                        { 
                            <div class="col-md-4">
                                <img src="@shot.ImagePath" class="img-fluid rounded-3 screenshot-thumb" alt="@shot.Caption" />
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="col-lg-5" data-aos="fade-left">
                <div class="glass-card p-4">
                    <h4 class="mb-3">Overview</h4>
                    <p class="text-muted-light">@Model.FullDescription</p>

                    <h5 class="mt-4 mb-2">Technology Stack</h5>
                    <div class="tech-badges">
                        @foreach (var tech in Model.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="tech-badge">@tech.Trim()</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Features))
                    {
                        <h5 class="mt-4 mb-2">Key Features</h5>
                        <ul class="responsibilities-list">
                            @foreach (var f in Model.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>@f.Trim()</li>
                            }
                        </ul>
                    }

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                        {
                            <a href="@Model.GitHubUrl" target="_blank" rel="noopener" class="btn btn-outline-glass"><i class="fa-brands fa-github"></i> GitHub</a>
                        }
                        @if (!string.IsNullOrEmpty(Model.LiveDemoUrl))
                        {
                            <a href="@Model.LiveDemoUrl" target="_blank" rel="noopener" class="btn btn-gradient"><i class="fa-solid fa-up-right-from-square"></i> Live Demo</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <a asp-controller="Projects" asp-action="Index" class="btn btn-outline-glass"><i class="fa-solid fa-arrow-left"></i> Back to Projects</a>
        </div>
    </div>
</section>
