@{
    ViewData["Title"] = "Error";
}
<section class="section-padding error-page text-center">
    <div class="container">
        <h1 class="error-code">500</h1>
        <h3 class="mb-3">Something went wrong</h3>
        <p class="text-muted-light">An unexpected error occurred. Please try again later.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-gradient mt-3">Back to Home</a>
    </div>
</section>
