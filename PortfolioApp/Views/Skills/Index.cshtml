@model SkillsViewModel
@{
    ViewData["Title"] = "Skills";
}

<section class="page-header">
    <div class="container text-center" data-aos="fade-up">
        <span class="section-tag">What I Know</span>
        <h1>My <span class="text-gradient">Skills</span></h1>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        @foreach (var group in Model.SkillsByCategory)
        {
            <div class="mb-5">
                <h4 class="category-heading" data-aos="fade-up">
                    @switch (group.Key)
                    {
                        case SkillCategory.Backend: <text><i class="fa-solid fa-server"></i> Backend</text> break;
                        case SkillCategory.Frontend: <text><i class="fa-solid fa-palette"></i> Frontend</text> break;
                        case SkillCategory.Database: <text><i class="fa-solid fa-database"></i> Database</text> break;
                        case SkillCategory.Tools: <text><i class="fa-solid fa-toolbox"></i> Tools</text> break;
                        default: <text><i class="fa-solid fa-people-group"></i> Soft Skills</text> break;
                    }
                </h4>
                <div class="row g-4">
                    @foreach (var skill in group)
                    {
                        <div class="col-md-6" data-aos="fade-up">
                            <div class="skill-card glass-card">
                                <div class="skill-card-header">
                                    <span><i class="@skill.IconClass"></i> @skill.Name</span>
                                    <span class="skill-percent">@skill.ProficiencyLevel%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill" data-level="@skill.ProficiencyLevel"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
